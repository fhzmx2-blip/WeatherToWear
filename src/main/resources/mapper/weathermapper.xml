<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.weather.WeatherToWear.mapper.WeatherMapper">

    <insert id="weatherUpdate">
        INSERT INTO weather
        VALUES (
            #{region_code},
            #{time},
            #{temperature},
            #{apparent_temperature},
            #{relative_humidity},
            #{precipitation_mm},
            #{precipitation_probability},
            #{weather_code},
            #{wind_speed}
        )
    </insert>


</mapper>